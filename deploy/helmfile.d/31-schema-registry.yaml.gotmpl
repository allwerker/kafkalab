# T105: Karapace schema registry + schema registration hook. The .avsc files are read straight from
# schemas/gen (generated by `make gen`), so no copy step is needed.
releases:
  - name: schema-registry
    namespace: data
    createNamespace: true
    chart: ../charts/schema-registry
    wait: true
    timeout: 600
    values:
      - kafka:
          defaultReplicationFactor: {{ .Values.kafka.defaultReplicationFactor }}
        schemas:
{{- range $f := readDir "../../schemas/gen" }}
{{- if hasSuffix ".avsc" $f }}
          {{ base $f | trimSuffix ".avsc" }}: {{ readFile $f | toJson }}
{{- end }}
{{- end }}
