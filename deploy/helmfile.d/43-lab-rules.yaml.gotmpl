# T308/T309: alerting + recording rules as VMRule objects (vmalert selects every VMRule).
# The lab runs the bundle in the fast "demo" profile; production users deploy kafka-production.yaml.
# Rule files are generated by `make alerts` (monitoring/dashgen) and read here directly.
releases:
  - name: lab-rules
    namespace: monitoring
    chart: ../charts/lab-rules
    values:
      - ruleFiles:
          kafka-bundle: {{ readFile "../../monitoring/bundle/alerts/kafka-demo.yaml" | toJson }}
          kafka-lab-business: {{ readFile "../../monitoring/demo/alerts/business.yaml" | toJson }}
