# Controlboard (namespace control): ServiceAccount/RBAC, then the board itself from the generic
# lab-service chart. Image tag from .tools/image-tags.yaml (written by `make images`).
{{- $tags := dict }}
{{- $tagFile := "../../.tools/image-tags.yaml" }}
{{- if isFile $tagFile }}{{ $tags = (readFile $tagFile | fromYaml).images | default dict }}{{ end }}
releases:
  - name: controlboard-rbac
    namespace: control
    createNamespace: true
    chart: ../charts/controlboard-rbac
    labels:
      name: controlboard
{{- if hasKey $tags "controlboard" }}
  - name: controlboard
    namespace: control
    createNamespace: true
    chart: ../charts/lab-service
    needs: [control/controlboard-rbac]
    values:
      - name: controlboard
        tracing: {{ .Values.extras.traces }}
        replicas: 1
        image:
          registry: {{ .Values.registry }}
          tag: {{ index $tags "controlboard" | quote }}
        env:
          BROKER_COUNT: {{ .Values.kafka.replicas | quote }}
      - ../values/services/controlboard.yaml
{{- end }}
