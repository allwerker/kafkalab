[
  {
    "id": "black-friday",
    "name": "Black Friday",
    "description": "Orders jump from 50/s to 1,000/s. Watch throughput spike and consumer lag build up behind the slowest service.",
    "category": "traffic",
    "severity": "high",
    "destructive": false,
    "defaultDurationSec": 180,
    "params": [
      {
        "key": "ordersPerSecond",
        "label": "Orders per second",
        "type": "number",
        "min": 100,
        "max": 2000,
        "step": 50,
        "default": 1000,
        "unit": "orders/s"
      },
      {
        "key": "paymentLatencyMs",
        "label": "Payment latency",
        "type": "number",
        "min": 0,
        "max": 1000,
        "step": 10,
        "default": 150,
        "unit": "ms"
      },
      {
        "key": "inventoryLatencyMs",
        "label": "Inventory latency",
        "type": "number",
        "min": 0,
        "max": 1000,
        "step": 10,
        "default": 100,
        "unit": "ms"
      },
      {
        "key": "randomize",
        "label": "Randomize bursts",
        "type": "boolean",
        "default": false
      }
    ],
    "expectedSymptoms": [
      "orders/s ×20",
      "consumer lag grows on payment and inventory",
      "e2e p95 latency rises"
    ],
    "dashboards": [
      {
        "title": "Business KPIs",
        "url": "http://grafana.localhost:8080/d/lab-business"
      },
      {
        "title": "Consumer Lag",
        "url": "http://grafana.localhost:8080/d/kafka-lag"
      }
    ]
  },
  {
    "id": "flash-sale",
    "name": "Flash Sale",
    "description": "Sudden demand for one popular SKU. Inventory rows contend for the same lock and stock runs out.",
    "category": "traffic",
    "severity": "medium",
    "destructive": false,
    "defaultDurationSec": 120,
    "params": [
      {
        "key": "sku",
        "label": "Popular SKU",
        "type": "select",
        "options": [
          "SKU-1337",
          "SKU-0042",
          "SKU-0815"
        ],
        "default": "SKU-1337"
      },
      {
        "key": "probability",
        "label": "Share of orders",
        "type": "number",
        "min": 0.1,
        "max": 1,
        "step": 0.05,
        "default": 0.7
      },
      {
        "key": "ordersPerSecond",
        "label": "Orders per second",
        "type": "number",
        "min": 50,
        "max": 1000,
        "step": 50,
        "default": 200,
        "unit": "orders/s"
      }
    ],
    "expectedSymptoms": [
      "reservation success rate drops",
      "inventory.rejected spikes",
      "cancellations and refunds"
    ],
    "dashboards": [
      {
        "title": "Business KPIs",
        "url": "http://grafana.localhost:8080/d/lab-business"
      },
      {
        "title": "PostgreSQL",
        "url": "http://grafana.localhost:8080/d/lab-postgres"
      }
    ]
  },
