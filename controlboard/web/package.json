{
  "name": "kafka-lab-controlboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "bun run mock/server.ts",
    "record": "bun run mock/record.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && bun run scripts/lint-test-names.ts",
    "smoke": "bun run scripts/smoke.ts",
    "live-check": "bun run scripts/live-check.ts",
    "perf-check": "bun run scripts/perf-check.ts",
    "frame-profile": "bun run scripts/frame-profile.ts",
    "readme-shots": "bun run scripts/readme-shots.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "lucide-react": "1.71.0",
    "phaser": "4.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "31.0.0",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
