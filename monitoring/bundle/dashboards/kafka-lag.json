          "editorMode": "code",
          "expr": "sum by (group_id, topic_name) (kminion_kafka_consumer_group_topic_lag{kafka_cluster=\"$kafka_cluster\",group_id=~\"$group\",topic_name=~\"$topic\"}) / (sum by (group_id, topic_name) (rate(kminion_kafka_consumer_group_topic_offset_sum{kafka_cluster=\"$kafka_cluster\",group_id=~\"$group\",topic_name=~\"$topic\"}[5m])) > 0)",
          "format": "time_series",
