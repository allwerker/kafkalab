        "uid": "${datasource}"
      },
      "description": "Messages per second committed by each group (solid) and produced into the topic (dashed). When the consume line stays below the produce line, lag grows.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "shades"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisSoftMin": 0,
