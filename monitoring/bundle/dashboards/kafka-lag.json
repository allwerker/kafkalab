          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (group_id, topic_name) (kminion_kafka_consumer_group_topic_lag{kafka_cluster=\"$kafka_cluster\",group_id=~\"$group\",topic_name=~\"$topic\"})",
          "format": "time_series",
          "hide": false,
          "instant": false,
          "legendFormat": "{{group_id}} · {{topic_name}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Lag per group and topic",
