    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Lag ÷ consume rate (5 m) per group and topic: seconds a consumer needs to drain its backlog at its current speed. Better than raw lag for SLOs because it is independent of throughput. Thresholds: 1 min (yellow), 10 min (red). Groups that consume nothing at all have no estimate — they appear under Stalled consumers.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "purple",
