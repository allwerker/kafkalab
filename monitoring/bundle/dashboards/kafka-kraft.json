    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 7,
      "panels": [],
      "title": "Quorum membership",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Role of each node in the metadata quorum over time: leader (active controller), follower (voter), observer (broker-only node) or candidate/unattached during elections. Exactly one leader at any time is healthy.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "links": [],
          "mappings": [
            {
              "options": {
                "3": {
                  "color": "green",
                  "index": 0,
                  "text": "leader"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "color": "blue",
                  "index": 1,
                  "text": "follower"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "purple",
                  "index": 2,
                  "text": "observer"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "0": {
                  "color": "orange",
                  "index": 3,
                  "text": "electing"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "options": {
        "alignValue": "left",
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "rowHeight": 0.85,
        "showValue": "auto",
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (kafka_broker) (\n  (kafka_server_raftmetrics_current_state{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\",current_state=\"leader\"} * 3)\n  or (kafka_server_raftmetrics_current_state{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\",current_state=\"follower\"} * 2)\n  or (kafka_server_raftmetrics_current_state{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\",current_state=\"observer\"} * 1)\n  or (kafka_server_raftmetrics_current_state{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\",current_state!~\"leader|follower|observer\"} * 0)\n)",
          "format": "time_series",
          "hide": false,
          "instant": false,
          "legendFormat": "node {{kafka_broker}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Raft role per node",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Number of voters and observers as seen by each node, plus uncommitted voter changes (a KIP-853 reconfiguration in flight).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
          "links": [],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
