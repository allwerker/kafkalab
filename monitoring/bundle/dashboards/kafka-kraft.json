        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (kafka_broker) (kafka_server_raftmetrics_number_of_voters{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\"})",
          "format": "table",
          "hide": false,
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (kafka_broker) (kafka_server_raftmetrics_current_leader{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\"})",
          "format": "table",
          "hide": false,
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (kafka_broker) (kafka_server_raftmetrics_current_epoch{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\"})",
          "format": "table",
          "hide": false,
          "instant": true,
          "legendFormat": "",
          "range": false,
          "refId": "C"
        }
      ],
      "title": "Voters & observers",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Voters",
              "Value #B": "Leader seen",
              "Value #C": "Epoch",
              "kafka_broker": "Node"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "id": 10,
