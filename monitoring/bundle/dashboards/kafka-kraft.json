          "editorMode": "code",
          "expr": "max by (kafka_broker) (kafka_server_raftmetrics_log_end_offset{kafka_cluster=\"$kafka_cluster\",kafka_broker=~\"$kafka_broker\"})",
          "format": "time_series",
          "hide": false,
