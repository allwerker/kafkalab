          },
          "editorMode": "code",
          "expr": "max(kafka_controller_kafkacontroller_fencedbrokercount{kafka_cluster=\"$kafka_cluster\"})",
          "format": "time_series",
          "hide": false,
          "instant": false,
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Fenced brokers",
