{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "name": "Chaos & incidents (tag chaos)",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "chaos",
            "incident"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",component=~\"kafka|consumer\"}",
        "hide": false,
        "iconColor": "red",
        "name": "Firing Kafka alerts",
        "step": "30s",
        "tagKeys": "severity,component",
        "textFormat": "severity {{severity}} · component {{component}}",
        "titleFormat": "{{alertname}}",
        "useValueForTime": false
      }
    ]
  },
  "description": "KMinion continuously produces small probe messages (acks=all) to its own topic with one partition per broker and consumes them again. This is the closest thing to an application's view: if the probe is slow or loses messages, applications are affected too.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "kafka-bundle"
      ],
      "targetBlank": false,
      "title": "Kafka dashboards",
      "type": "dashboards"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Probe messages received back divided by messages produced during the last 5 minutes. 100 % = healthy; below 99 % messages are lost or exceed the roundtrip SLA.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "decimals": 1,
          "links": [],
          "mappings": [],
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.95
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum(increase(kminion_end_to_end_messages_received_total{kafka_cluster=\"$kafka_cluster\"}[5m])) / clamp_min(sum(increase(kminion_end_to_end_messages_produced_total{kafka_cluster=\"$kafka_cluster\"}[5m])), 1)",
          "format": "time_series",
          "hide": false,
          "instant": false,
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Probe success (5 m)",
      "type": "stat"
    },
    {
