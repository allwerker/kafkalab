      "title": "Controlboard",
      "type": "link",
      "url": "http://board.localhost:8080"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vlogs"
      },
      "description": "Log lines per interval and namespace. A sudden burst usually is a crash loop or a retry storm.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "shades"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": 60000,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [],
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vlogs"
          },
          "expr": "kubernetes.pod_namespace:in($namespace) $filter | stats by (kubernetes.pod_namespace) count() lines",
          "hide": false,
          "legendFormat": "{{kubernetes.pod_namespace}}",
          "queryType": "statsRange",
          "refId": "A"
        }
      ],
      "title": "Log volume by namespace",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vlogs"
      },
      "description": "Lines at level error/warn (JSON logs of the Go services) or containing ERROR/Exception (Kafka, JVM), per namespace.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "shades"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisSoftMin": 0,
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "opacity",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": 60000,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "links": [],
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vlogs"
          },
          "expr": "kubernetes.pod_namespace:in($namespace) (level:in(ERROR, error, WARN, warn) or \"ERROR\" or \"Exception\") $filter | stats by (kubernetes.pod_namespace) count() errors",
          "hide": false,
          "legendFormat": "{{kubernetes.pod_namespace}}",
          "queryType": "statsRange",
          "refId": "A"
        }
      ],
      "title": "Errors and warnings",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "vlogs"
      },
      "description": "Newest first. Click a line for all fields (pod, container, trace_id → jump to the trace).",
      "fieldConfig": {
        "defaults": {
          "links": [],
          "mappings": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "vlogs"
          },
          "expr": "kubernetes.pod_namespace:in($namespace) $filter | sort by (_time) desc | limit 500",
          "hide": false,
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Log lines",
      "type": "logs"
    }
  ],
