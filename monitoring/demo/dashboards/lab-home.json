{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "expr": "max by (experiment_id, scenario, category, severity) (lab_experiment_active) > 0",
        "hide": false,
        "iconColor": "orange",
        "name": "Chaos experiments",
        "step": "30s",
        "tagKeys": "category,severity",
        "textFormat": "{{category}} · severity {{severity}} · id {{experiment_id}}",
        "titleFormat": "{{scenario}}",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "yellow",
        "name": "Chaos & incidents (tag chaos)",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "chaos",
            "incident"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",severity=~\"critical|warning\",component!=\"\"}",
        "hide": false,
        "iconColor": "red",
        "name": "Firing alerts",
        "step": "30s",
        "tagKeys": "severity,component",
        "textFormat": "severity {{severity}} · component {{component}}",
        "titleFormat": "{{alertname}}",
        "useValueForTime": false
      }
    ]
  },
