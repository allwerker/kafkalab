        "titleFormat": "{{scenario}}",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": false,
        "iconColor": "yellow",
        "name": "Chaos & incidents (tag chaos)",
        "target": {
          "limit": 100,
          "matchAny": true,
          "tags": [
            "chaos",
            "incident"
          ],
          "type": "tags"
        }
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "expr": "ALERTS{alertstate=\"firing\",severity=~\"critical|warning\",component!=\"\"}",
        "hide": false,
        "iconColor": "red",
        "name": "Firing alerts",
        "step": "30s",
        "tagKeys": "severity,component",
        "textFormat": "severity {{severity}} · component {{component}}",
        "titleFormat": "{{alertname}}",
        "useValueForTime": false
      }
    ]
