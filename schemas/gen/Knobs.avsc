{
  "type" : "record",
  "name" : "Knobs",
  "namespace" : "lab.platform",
  "doc" : "Runtime knobs. Every field has a neutral default; services ignore knobs that do not apply to them.",
  "fields" : [ {
    "name" : "paused",
    "type" : "boolean",
    "doc" : "Stop consuming without crashing (\"Silent Failure\", \"Recovery Storm\").",
    "default" : false
  }, {
    "name" : "processingLatencyMs",
    "type" : "int",
    "doc" : "Extra processing time per record and its random jitter.",
    "default" : 0
  }, {
    "name" : "processingJitterMs",
    "type" : "int",
    "default" : 0
  }, {
    "name" : "processingErrorProbability",
    "type" : "double",
    "doc" : "Probability of a transient processing error (retried, never dead-lettered).",
    "default" : 0.0
  }, {
    "name" : "businessFailureProbability",
    "type" : [ "null", "double" ],
    "doc" : "Probability of a business failure (payment declined, ...). null = service default.",
    "default" : null
  }, {
    "name" : "providerDown",
    "type" : "boolean",
    "doc" : "Payment provider outage: every authorisation fails with PROVIDER_UNAVAILABLE.",
    "default" : false
  }, {
    "name" : "dbLatencyMs",
    "type" : "int",
    "doc" : "Extra latency for each database transaction (\"Database Slowdown\").",
    "default" : 0
  }, {
    "name" : "netLatencyMs",
    "type" : "int",
    "doc" : "Client-side network faults on the business Kafka client (\"Network Chaos\").",
    "default" : 0
  }, {
    "name" : "netDropProbability",
    "type" : "double",
    "default" : 0.0
  }, {
    "name" : "warehouseOutage",
    "type" : "boolean",
    "doc" : "Shipping: warehouse outage, shipments are delayed until it ends.",
    "default" : false
  }, {
    "name" : "ordersPerSecond",
    "type" : [ "null", "double" ],
    "doc" : "Generator only. null = default rate.",
    "default" : null
  }, {
    "name" : "popularSku",
    "type" : [ "null", "string" ],
    "doc" : "Generator: share of orders for one popular SKU (\"Flash Sale\").",
    "default" : null
  }, {
    "name" : "popularSkuProbability",
    "type" : "double",
    "default" : 0.0
  }, {
    "name" : "hotPartition",
    "type" : [ "null", "int" ],
    "doc" : "Generator: share of orders whose id hashes onto one partition (\"Hot Partition\").",
    "default" : null
  }, {
    "name" : "hotPartitionRatio",
    "type" : "double",
    "default" : 0.0
  }, {
    "name" : "paddingBytes",
    "type" : "int",
    "doc" : "Generator: payload filler per order (\"Fat Messages\").",
    "default" : 0
  }, {
    "name" : "duplicateProbability",
    "type" : "double",
    "doc" : "Generator: probability to publish an order twice (\"Duplicate Delivery\").",
    "default" : 0.0
  }, {
    "name" : "poisonProbability",
    "type" : "double",
    "doc" : "Generator: probability to publish an undecodable record (\"Poison Message\").",
    "default" : 0.0
  }, {
    "name" : "client",
    "type" : {
      "type" : "record",
      "name" : "ClientTuning",
      "doc" : "Client settings for the Tuning Lab. null = keep the service default.",
      "fields" : [ {
        "name" : "acks",
        "type" : [ "null", "string" ],
        "doc" : "\"all\", \"leader\" or \"none\". Anything but \"all\" disables idempotence (lossy).",
        "default" : null
      }, {
        "name" : "lingerMs",
        "type" : [ "null", "int" ],
        "default" : null
      }, {
        "name" : "batchMaxBytes",
        "type" : [ "null", "int" ],
        "default" : null
      }, {
        "name" : "compression",
        "type" : [ "null", "string" ],
        "doc" : "\"none\", \"gzip\", \"snappy\", \"lz4\", \"zstd\".",
        "default" : null
      }, {
        "name" : "fetchMaxBytes",
        "type" : [ "null", "int" ],
        "default" : null
      }, {
        "name" : "fetchMaxWaitMs",
        "type" : [ "null", "int" ],
        "default" : null
      }, {
        "name" : "fetchMinBytes",
        "type" : [ "null", "int" ],
        "default" : null
      }, {
        "name" : "maxPollRecords",
        "type" : [ "null", "int" ],
        "default" : null
      } ]
    },
    "default" : { }
  } ]
}
